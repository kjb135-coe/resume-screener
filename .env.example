# Copy to .env and fill in. .env is gitignored; never commit a real key.
# The test suite needs none of this -- it never calls an API.

# Scores every resume (panel + arbiter).
OPENAI_API_KEY=sk-...

# Pulls quoted evidence out of each resume, in every configuration.
# Required even though the scoring runs on OpenAI.
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the app. If you leave this unset, a random one is
# generated per process and printed to the log -- there is no default,
# because a default in a public repo is a published password.
APP_PASSWORD=

# Hosted spend caps. See docs/HOSTING.md.
DAILY_BUDGET_USD=3.00
MAX_RESUMES_PER_RUN=20
